patch
{
    include "materials/models/survivors/survivors_it_shared.vmt"
    insert
    {
        $BaseTexture "models\survivors\zoey_body\Legs"
        $BumpMap "models\survivors\zoey_body\legs_n.vtf"
        $halflambert 1

        $nodecal 1
        $phong 1
        $phongboost "0.6"
        $phongexponent 15
        $PhongExponentTexture "models\survivors\zoey_body\legs_Spec.vtf"
        $basemapalphaphongmask 1
        $phongalbedotint 1
        $phongtint "[1 0.6 0.4]"
        $phongfresnelranges "[0.2 0.5 1.5]"

        $rimlight 1
        $rimlightexponent 4
        $rimlightboost 0.5

        $ambientocclusion 1
        $nocull 1
    }
}
